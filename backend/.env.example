# LLM 提供商配置
# 选择: openai / qwen / deepseek
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# 通义千问 (Qwen) - OpenAI 兼容接口
QWEN_API_KEY=sk-xxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# DeepSeek - OpenAI 兼容接口
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 语音识别（ASR）
ASR_PROVIDER=capswriter
CAPSWRITER_URL=ws://localhost:6016
VOSK_URL=http://localhost:6702
FUNASR_URL=ws://localhost:10095

# 讨论配置
MAX_TURNS=30
HUMAN_TURN_TIMEOUT=15

# Boson AI 配置
BOSON_API_KEY=sk-xxx
BOSON_BASE_URL=https://api.boson.ai/v1
BOSON_TTS_MODEL=higgs-audio-v3
BOSON_AVATAR_URL=
BOSON_AVATAR_ENABLED=false

# ElevenLabs v3（拟真天花板，支持逐句情绪 audio tag）
# 拟真档：eleven_v3；低延迟档：eleven_flash_v2_5
ELEVENLABS_TTS_API_KEY=
ELEVENLABS_TTS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_TTS_VOICE=
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TTS_STREAM=true

# MiniMax Speech（中文最强档，支持 happy/sad/angry/fearful/disgusted/surprised/calm/fluent/whisper）
# 音质优先：speech-2.8-hd；速度优先：speech-2.8-turbo
MINIMAX_TTS_API_KEY=
MINIMAX_TTS_GROUP_ID=
MINIMAX_TTS_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TTS_VOICE=